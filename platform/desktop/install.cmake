if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Linux|Darwin)$")
    return()
endif()

if(APPLE)
    add_executable(DynaBroCollection MACOSX_BUNDLE platform/desktop/launcher.c)
    set_target_properties(DynaBroCollection PROPERTIES
        MACOSX_BUNDLE_BUNDLE_NAME "DynaBroCollection"
        MACOSX_BUNDLE_GUI_IDENTIFIER "org.dynabro.collection"
        MACOSX_BUNDLE_SHORT_VERSION_STRING "${PROJECT_VERSION}"
        MACOSX_BUNDLE_BUNDLE_VERSION "${PROJECT_VERSION}")
    set(_runner_dir "DynaBroCollection.app/Contents/MacOS")
    set(_resource_dir "DynaBroCollection.app/Contents/Resources")
    set(_library_dir "${_runner_dir}")
    set(_library_lookup "@loader_path")
    set(DYNA_SDL2_FRAMEWORK "" CACHE PATH "SDL2.framework to bundle instead of individual dylibs")
    if(DYNA_SDL2_FRAMEWORK)
        list(APPEND _library_lookup "@executable_path/../Frameworks")
        install(DIRECTORY "${DYNA_SDL2_FRAMEWORK}" DESTINATION "DynaBroCollection.app/Contents/Frameworks")
    endif()
    set(_sdl2_name "libSDL2-2.0.0.dylib")
    set(_sdl3_name "libSDL3.dylib")
else()
    add_executable(DynaBroCollection platform/desktop/launcher.c)
    set(_runner_dir ".")
    set(_resource_dir ".")
    set(_library_dir "lib")
    set(_library_lookup "$ORIGIN/lib")
    set(_sdl2_name "libSDL2-2.0.so.0")
    set(_sdl3_name "libSDL3.so.0")
endif()

target_sources(DynaBroCollection PRIVATE games/launcher_discovery.c games/launcher_options.c games/launcher_profile.c)
target_compile_definitions(DynaBroCollection PRIVATE SDL_MAIN_HANDLED)
target_include_directories(DynaBroCollection PRIVATE games)
target_link_libraries(DynaBroCollection PRIVATE SDL2::SDL2)
add_dependencies(DynaBroCollection DynaBrothers1AOT DynaBrothers2AOT)
foreach(_target IN ITEMS DynaBroCollection DynaBrothers1AOT DynaBrothers2AOT)
    set_target_properties(${_target} PROPERTIES INSTALL_RPATH "${_library_lookup}")
endforeach()

set(DYNA_SDL2_RUNTIME "" CACHE FILEPATH "sdl2-compat shared library to include in the desktop installation")
set(DYNA_SDL3_RUNTIME "" CACHE FILEPATH "SDL3 shared library to include in the desktop installation")
set(DYNA_SDL_RUNTIME_LICENSES "" CACHE STRING "List of licenses for bundled SDL runtime libraries")

install(TARGETS DynaBroCollection BUNDLE DESTINATION . RUNTIME DESTINATION "${_runner_dir}")
install(TARGETS DynaBrothers1AOT DynaBrothers2AOT RUNTIME DESTINATION "${_runner_dir}")
install(DIRECTORY "${CMAKE_BINARY_DIR}/assets" DESTINATION "${_resource_dir}" PATTERN boxart_sonic1.tga EXCLUDE)
install(FILES "${CMAKE_SOURCE_DIR}/recomplauncher.json" DESTINATION .)
install(FILES "${CMAKE_SOURCE_DIR}/README.md" "${CMAKE_SOURCE_DIR}/THIRD_PARTY_NOTICES.md"
    DESTINATION "${_resource_dir}")
set(_achievements_sdk "${CMAKE_SOURCE_DIR}/third_party/recomp-achievements")
install(FILES "${_achievements_sdk}/LICENSE" DESTINATION "${_resource_dir}/licenses" RENAME "RecompAchievements.txt")
install(FILES "${_achievements_sdk}/sdk/third_party/cjson/LICENSE"
    DESTINATION "${_resource_dir}/licenses" RENAME "RecompAchievements-cJSON.txt")
install(FILES "${_achievements_sdk}/sdk/third_party/rcheevos/LICENSE"
    DESTINATION "${_resource_dir}/licenses" RENAME "RecompAchievements-rcheevos.txt")
if(DYNA_SDL2_RUNTIME)
    install(FILES "${DYNA_SDL2_RUNTIME}" DESTINATION "${_library_dir}" RENAME "${_sdl2_name}")
endif()
if(DYNA_SDL3_RUNTIME)
    install(FILES "${DYNA_SDL3_RUNTIME}" DESTINATION "${_library_dir}" RENAME "${_sdl3_name}")
endif()
if(DYNA_SDL_RUNTIME_LICENSES)
    install(FILES ${DYNA_SDL_RUNTIME_LICENSES} DESTINATION "${_resource_dir}/licenses")
endif()
