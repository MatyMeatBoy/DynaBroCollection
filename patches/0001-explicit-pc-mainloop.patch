 #define GENESIS_NATIVE_INTERRUPT_FRAME_H
 #include <stdint.h>
 
+/* A pending request remains asserted until the CPU acknowledges that level. */
+static inline unsigned native_interrupt_pending_level(int vint,int hint,uint16_t sr,int hint_enabled)
+{
+    unsigned mask=(sr>>8)&7u;
+    if(vint&&mask<6)return 6;
+    if(hint&&hint_enabled&&mask<4)return 4;
+    return 0;
+}
+static inline void native_interrupt_ack_pending(int *vint,int *hint,unsigned level)
+{
+    if(level==6)*vint=0;
+    else if(level==4)*hint=0;
+}
+
 /* MC68000 format-0 interrupt frame: SR, then the interrupted PC. Guest
  * handlers may rewrite either field before RTE. Work RAM wraps at 64 KiB. */
 static inline void native_interrupt_frame_write(uint8_t ram[65536],uint32_t sp,
