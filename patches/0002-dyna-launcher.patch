diff --git a/tests/host_surface_test.c b/tests/host_surface_test.c
new file mode 100644
index 0000000..45d7f2e
--- /dev/null
+++ b/tests/host_surface_test.c
@@ -0,0 +1,48 @@
+#ifndef SDL_MAIN_HANDLED
+#define SDL_MAIN_HANDLED
+#endif
+#include "launcher_platform.h"
+#include "launcher_gl.h"
+#include <stdio.h>
+#include <stdint.h>
+
+#define CHECK(x) do { if (!(x)) { fprintf(stderr,"FAIL line %d: %s\n",__LINE__,SDL_GetError());return 1;} } while(0)
+int main(void) {
+    SDL_SetHint(SDL_HINT_VIDEODRIVER,"dummy");
+    CHECK(SDL_Init(SDL_INIT_VIDEO)==0);
+    SDL_Window *window=SDL_CreateWindow("Host",0,0,640,480,SDL_WINDOW_HIDDEN);
+    CHECK(window);
+    Uint32 id=SDL_GetWindowID(window);
+    SDL_Renderer *renderer=SDL_CreateRenderer(window,-1,SDL_RENDERER_SOFTWARE);
+    CHECK(renderer);
+    CHECK(SDL_RenderSetLogicalSize(renderer,320,224)==0);
+    SDL_SetRenderDrawColor(renderer,12,23,34,45);
+    LauncherPlatform p={0};
+    CHECK(launcher_platform_attach_sdl2(&p,window,renderer));
+    CHECK(p.window==window && p.renderer==renderer && p.borrowed_surface);
+    CHECK(!p.gl && p.pixel_w==640 && p.pixel_h==480);
+    launcher_texture_set_sdl_renderer(renderer);
+    // A two-pixel, uncompressed 32-bit TGA exercises upload without any GL context.
+    const unsigned char image[]={0,0,2,0,0,0,0,0,0,0,0,0,2,0,1,0,32,0x28,
+        0,0,255,255,0,255,0,255};
+    FILE *f=fopen("host_surface_test.tga","wb");CHECK(f);
+    CHECK(fwrite(image,1,sizeof image,f)==sizeof image);fclose(f);
+    LauncherTexture t=launcher_texture_load("host_surface_test.tga");
+    CHECK(t.id && t.w==2 && t.h==1);
+    Uint32 format=0;int access=0,w=0,h=0;
+    CHECK(SDL_QueryTexture((SDL_Texture*)(uintptr_t)t.id,&format,&access,&w,&h)==0);
+    CHECK(w==2 && h==1);
+    launcher_texture_free(&t);CHECK(!t.id);
+    launcher_texture_set_sdl_renderer(NULL);
+    remove("host_surface_test.tga");
+    launcher_platform_present(&p);
+    launcher_platform_close(&p);
+    CHECK(SDL_GetWindowFromID(id)==window && SDL_GetRenderer(window)==renderer);
+    SDL_RenderGetLogicalSize(renderer,&w,&h);CHECK(w==320 && h==224);
+    Uint8 r,g,b,a;SDL_GetRenderDrawColor(renderer,&r,&g,&b,&a);
+    CHECK(r==12 && g==23 && b==34 && a==45);
+    CHECK(SDL_WasInit(SDL_INIT_VIDEO));
+    SDL_DestroyRenderer(renderer);SDL_DestroyWindow(window);SDL_Quit();
+    puts("ok: borrowed host window, SDL texture upload, renderer state and SDL lifetime");
+    return 0;
+}
diff --git a/tests/host_surface_ui_test.cpp b/tests/host_surface_ui_test.cpp
new file mode 100644
index 0000000..7e34b68
--- /dev/null
+++ b/tests/host_surface_ui_test.cpp
@@ -0,0 +1,79 @@
+#ifndef SDL_MAIN_HANDLED
+#define SDL_MAIN_HANDLED
+#endif
+#include "recomp_launcher.h"
+#include "launcher_system.h"
+#include "imgui.h"
+#include <SDL.h>
+#include <cstdio>
+#include <cstdlib>
+#if defined(_WIN32)
+#include <windows.h>
+#endif
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr,"FAIL line %d: %s\n",__LINE__,SDL_GetError());return 1;} } while(0)
+int main(int argc, char**) {
+    const bool native = argc > 1;
+    if (!native) SDL_SetHint(SDL_HINT_VIDEODRIVER,"dummy");
+#if defined(_WIN32)
+    _putenv_s("LNG_FORCE_SCALE", "1.25");
+#else
+    setenv("LNG_FORCE_SCALE", "1.25", 1);
+#endif
+    CHECK(SDL_Init(SDL_INIT_VIDEO|SDL_INIT_GAMECONTROLLER)==0);
+    SDL_Window* window = nullptr;
+#if defined(_WIN32)
+    HWND hwnd = nullptr;
+    if (native) {
+        hwnd = CreateWindowExW(0, L"STATIC", L"Borrowed native DPI fixture",
+                              WS_OVERLAPPEDWINDOW, 100, 100, 1400, 1000,
+                              nullptr, nullptr, GetModuleHandleW(nullptr), nullptr);
+        CHECK(hwnd);
+        window = SDL_CreateWindowFrom(hwnd);
+    }
+#endif
+    if (!native) window=SDL_CreateWindow("Host game",0,0,1100,880,SDL_WINDOW_HIDDEN);
+    CHECK(window);
+    Uint32 id=SDL_GetWindowID(window);
+    SDL_Renderer* renderer=SDL_CreateRenderer(window,-1,SDL_RENDERER_SOFTWARE);
+    CHECK(renderer);
+    SDL_RenderSetLogicalSize(renderer,320,224);
+    ImGuiContext* host_context=ImGui::CreateContext();
+    RecompLauncherCSettings settings={};
+    settings.player_src[0]=3;settings.pad_mode[0]=1;
+    RecompLauncherCGameInfo game={};
+    launcher_profile_apply_genesis(&game);
+    game.name="Borrowed host settings test";game.theme="dyna";game.initial_page="settings";
+    game.in_session=1;game.num_players=2;
+    game.config_path="host_surface_ui_fixture.ini";
+    game.keybinds_path="host_surface_ui_fixture.ini";
+    game.host_sdl_window=window;game.host_sdl_renderer=renderer;
+    SDL_setenv("LNG_SCRIPT","wait:2;shot:host_surface_dashboard.png;view:settings;wait:2;shot:host_surface_settings.png;view:controller;wait:2;shot:host_surface_controller.png;quit",1);
+    char rom[1024]={};
+    int result=recomp_launcher_run_window("Same window",&settings,&game,nullptr,nullptr,rom,sizeof rom);
+    CHECK(result==RECOMP_LAUNCHER_RESULT_QUIT);
+    // The full-window green theme outline must reach the output's right edge.
+    // Without renderer vertex scaling the logical root stops at 80% at 125% DPI.
+    int output_w=0, output_h=0;
+    CHECK(SDL_GetRendererOutputSize(renderer,&output_w,&output_h)==0);
+    SDL_Rect edge={output_w-4,output_h/2,4,1};
+    Uint32 pixels[4]={};
+    CHECK(SDL_RenderReadPixels(renderer,&edge,SDL_PIXELFORMAT_ARGB8888,pixels,sizeof pixels)==0);
+    bool reached_edge=false;
+    for (Uint32 color:pixels) if (((color>>8)&255)>90) reached_edge=true;
+    if (!native) CHECK(reached_edge); // native backbuffers may be invalid after Present
+    CHECK(ImGui::GetCurrentContext()==host_context);
+    CHECK(SDL_GetWindowFromID(id)==window && SDL_GetRenderer(window)==renderer);
+    int w,h;SDL_RenderGetLogicalSize(renderer,&w,&h);CHECK(w==320 && h==224);
+    SDL_Window* next=SDL_CreateWindow("Window ID sentinel",0,0,16,16,SDL_WINDOW_HIDDEN);
+    CHECK(next && SDL_GetWindowID(next)==id+1); // launcher never created another SDL window
+    SDL_DestroyWindow(next);
+    ImGui::DestroyContext(host_context);
+    SDL_DestroyRenderer(renderer);SDL_DestroyWindow(window);SDL_Quit();
+#if defined(_WIN32)
+    if (hwnd) { CHECK(IsWindow(hwnd)); DestroyWindow(hwnd); }
+#endif
+    std::remove("host_surface_ui_fixture.ini");
+    std::puts("ok: full settings/controller/dashboard rendered in borrowed window; no extra window");
+    return 0;
+}
