+bool launcher_platform_attach_sdl2(LauncherPlatform* p, SDL_Window* window,
+                                   SDL_Renderer* renderer) {
+    if (!p || !window || !renderer || SDL_GetRenderer(window) != renderer) return false;
+    memset(p, 0, sizeof(*p));
+    p->window = window; p->renderer = renderer; p->borrowed_surface = true;
+    p->saved_target = SDL_GetRenderTarget(renderer);
+    SDL_RenderGetViewport(renderer, &p->saved_viewport);
+    SDL_RenderGetClipRect(renderer, &p->saved_clip);
+    p->saved_clip_enabled = SDL_RenderIsClipEnabled(renderer);
+    SDL_RenderGetScale(renderer, &p->saved_scale_x, &p->saved_scale_y);
+    SDL_RenderGetLogicalSize(renderer, &p->saved_logical_w, &p->saved_logical_h);
+    p->saved_integer_scale = SDL_RenderGetIntegerScale(renderer);
+    SDL_GetRenderDrawColor(renderer, &p->saved_r, &p->saved_g, &p->saved_b, &p->saved_a);
