diff --git a/tests/genesis_binding_snapshot_test.c b/tests/genesis_binding_snapshot_test.c
new file mode 100644
index 0000000..8a5f8e2
--- /dev/null
+++ b/tests/genesis_binding_snapshot_test.c
@@ -0,0 +1,33 @@
+#include "consoles/genesis/genesis_binds.h"
+#include <stdio.h>
+#include <string.h>
+
+static int host_binding(int p, int b, int* key, int* kind, int* code, int* dir) {
+    if (p || b != 6) return 0; // Genesis C = right trigger
+    *key = 6; *kind = RUI_GEN_BIND_AXIS; *code = 5; *dir = 1;
+    return 1;
+}
+int main(void) {
+    const char* path = "genesis_binding_snapshot_test.ini";
+    remove(path);
+    rui_genesis_binds_init_snapshot(path, host_binding);
+    int kind, code, dir;
+    rui_genesis_binds_get_pad(path, 0, 6, &kind, &code, &dir);
+    if (kind != RUI_GEN_BIND_AXIS || code != 5 || dir != 1 ||
+        rui_genesis_binds_get_key(path, 0, 6) != 6) return 1;
+    FILE* f = fopen(path, "rb");
+    if (f) { fclose(f); return 2; } // initialization never creates settings
+    f = fopen(path, "wb");
+    if (!f) return 3;
+    fputs("[input.p1]\npad.C = button:9\nkey.C = 42\n", f); fclose(f);
+    rui_genesis_binds_init_snapshot(path, host_binding);
+    rui_genesis_binds_get_pad(path, 0, 6, &kind, &code, &dir);
+    if (kind != RUI_GEN_BIND_BUTTON || code != 9 ||
+        rui_genesis_binds_get_key(path, 0, 6) != 42) return 4;
+    remove(path);
+    rui_genesis_binds_init(path);
+    rui_genesis_binds_get_pad(path, 0, 6, &kind, &code, &dir);
+    if (kind != RUI_GEN_BIND_BUTTON || code != 2) return 5;
+    puts("ok: host snapshot, explicit INI precedence, no writes, generic fallback");
+    return 0;
+}
