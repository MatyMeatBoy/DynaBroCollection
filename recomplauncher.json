{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "DynaBroCollection",
  "repo": "MatyMeatBoy/DynaBroCollection",
  "inputs": [
    {
      "id": "db1",
      "label": "Dyna Brothers (Japan), Mega Drive cartridge dump",
      "role": "game",
      "formats": [{ "type": "file", "extensions": ["md", "bin", "gen", "68k"] }]
    },
    {
      "id": "db2",
      "label": "Dyna Brothers 2 Special (Japan), Virtual Console dump",
      "role": "game",
      "formats": [{ "type": "file", "extensions": ["md", "bin", "gen", "68k"] }]
    }
  ],
  "start": {
    "program": [
      "data/DynaBrothersLauncher.exe",
      "DynaBroCollection",
      "DynaBroCollection.app/Contents/MacOS/DynaBroCollection"
    ]
  },
  "exit_codes": {
    "2": "The launch arguments were invalid. Check the selected game and ROM path.",
    "3": "The ROM file could not be found. Select your cartridge dump again.",
    "4": "The ROM file could not be read. Choose a regular file you can open.",
    "5": "This ROM revision is unsupported. Select a supported, uncompressed cartridge dump.",
    "6": "This ROM belongs to the other Dyna Brothers game. Select the matching cartridge dump.",
    "42": "ok"
  },
  "games": [
    {
      "id": "db1",
      "name": "Dyna Brothers",
      "inputs": ["db1"],
      "args": ["--game", "db1", "--rom", "{input:db1}", "--no-launcher"],
      "saves": [
        "{install}/data/dyna1-progress-*.bin",
        "{install}/data/dynabrothers-achievements-db1.txt",
        "{install}/dyna1-progress-*.bin",
        "{install}/dynabrothers-achievements-db1.txt",
        "{local}/DynaBroCollection/dyna1-progress-*.bin",
        "{local}/DynaBroCollection/dynabrothers-achievements-db1.txt"
      ]
    },
    {
      "id": "db2",
      "name": "Dyna Brothers 2 Special",
      "inputs": ["db2"],
      "args": ["--game", "db2", "--rom", "{input:db2}", "--no-launcher"],
      "saves": [
        "{install}/data/*.srm",
        "{install}/data/dyna2-progress-*.bin",
        "{install}/data/dynabrothers-achievements-db2.txt",
        "{install}/*.srm",
        "{install}/dyna2-progress-*.bin",
        "{install}/dynabrothers-achievements-db2.txt",
        "{local}/DynaBroCollection/*.srm",
        "{local}/DynaBroCollection/dyna2-progress-*.bin",
        "{local}/DynaBroCollection/dynabrothers-achievements-db2.txt"
      ]
    }
  ],
  "config": [
    { "id": "main", "format": "ini", "file": [
      { "path": "{local}/DynaBroCollection/settings.ini", "if": "{install}/DynaBroCollection.app" },
      { "path": "{install}/data/settings.ini", "if": "{install}/data/settings.ini" },
      { "path": "{install}/settings.ini", "if": "{install}/settings.ini" },
      { "path": "{local}/DynaBroCollection/settings.ini", "if": "{local}/DynaBroCollection/logs" },
      { "path": "{install}/data/settings.ini", "if": "{install}/data/DynaBrothersLauncher.exe" },
      { "path": "{install}/settings.ini" }
    ] },
    { "id": "language", "format": "ini", "file": [
      { "path": "{local}/DynaBroCollection/dynabrothers-language.ini", "if": "{install}/DynaBroCollection.app" },
      { "path": "{install}/data/dynabrothers-language.ini", "if": "{install}/data/dynabrothers-language.ini" },
      { "path": "{install}/dynabrothers-language.ini", "if": "{install}/dynabrothers-language.ini" },
      { "path": "{local}/DynaBroCollection/dynabrothers-language.ini", "if": "{local}/DynaBroCollection/logs" },
      { "path": "{install}/data/dynabrothers-language.ini", "if": "{install}/data/DynaBrothersLauncher.exe" },
      { "path": "{install}/dynabrothers-language.ini" }
    ] }
  ],
  "settings": [
    {
      "id": "display",
      "label": "Window mode",
      "help": "Pick how the game opens on your display.",
      "choices": [
        { "label": "Automatic", "set": { "video/fullscreen": "auto" } },
        { "label": "Windowed", "set": { "video/fullscreen": "0" } },
        { "label": "Borderless", "set": { "video/fullscreen": "1" } },
        { "label": "Exclusive fullscreen", "set": { "video/fullscreen": "2" } }
      ],
      "defaults": { "video/fullscreen": "auto" }
    },
    {
      "id": "filter",
      "label": "Pixel filtering",
      "help": "Choose sharp pixels or smooth scaling.",
      "choices": [
        { "label": "Sharp", "set": { "video/linear_filter": "0" } },
        { "label": "Smooth", "set": { "video/linear_filter": "1" } }
      ],
      "defaults": { "video/linear_filter": "0" }
    },
    {
      "id": "volume",
      "label": "Volume",
      "slider": { "key": "audio/volume", "min": 0, "max": 100, "step": 5, "format": "%d" },
      "defaults": { "audio/volume": "100" }
    },
    {
      "id": "language",
      "label": "Game language",
      "help": "Choose the partial English translation or the original Japanese.",
      "in": "language",
      "choices": [
        { "label": "English", "set": { "english": "1" } },
        { "label": "Japanese", "set": { "english": "0" } }
      ],
      "defaults": { "english": "1" }
    }
  ],
  "folders": { "logs": [
    { "path": "{install}/data/logs", "if": "{install}/data/logs" },
    { "path": "{install}/logs", "if": "{install}/logs" },
    { "path": "{local}/DynaBroCollection/logs" }
  ] }
}
